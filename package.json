{
  "name": "flint",
  "private": true,
  "description": "Flint: keyboard-first quick-capture notes and tasks for developers.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "npm run build -w @flint/core",
    "typecheck": "tsc -p packages/core/tsconfig.build.json --noEmit && tsc -p packages/core/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "measure": "npm run build && node packages/core/bench/measure.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
