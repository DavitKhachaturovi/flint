# Dependency policy (D-30, docs/05 §1).
# Refuse to run on a Node outside "engines" (>=24.22.1 <25: the security release, same major as Electron).
engine-strict=true
# Supply-chain cooldown: never install a version published less than 7 days ago. One-off exceptions
# for security fixes are recorded in D-30 and passed on the command line (--min-release-age=0).
min-release-age=7
# Exact versions in package.json; the lockfile pins the whole tree.
save-exact=true
