{
  "name": "@flint/desktop",
  "productName": "Flint",
  "version": "0.4.34",
  "private": true,
  "description": "Flint desktop app: Electron main process, preload bridge and renderers (docs/05).",
  "author": "Davit Khachaturovi",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "install-electron": "install-electron",
    "check:electron-node": "node scripts/check-electron-node.mjs",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win nsis --x64 && node scripts/check-fuses.mjs",
    "dist:bench": "electron-vite build --mode bench && electron-builder --config electron-builder.bench.yml --win zip --x64 && node scripts/check-fuses.mjs \"dist-bench/win-unpacked/Flint R-1 benchmark.exe\" && electron-vite build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@flint/core": "0.0.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
