{
  "name": "@flint/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Flint's note editor: CodeMirror 6 with the live preview, tables and conflict cards, shared by the desktop and the phone (D-165, docs/05 §2). DOM only.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/live-preview.ts"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./editor.css": "./src/editor.css"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@flint/core": "0.0.0",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1"
  }
}
